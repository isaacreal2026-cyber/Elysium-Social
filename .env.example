# ─── Server ────────────────────────────────────────────────────────
PORT=8080

# ─── Database (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/elysium_social

# ─── Mockup Sandbox (Vite) ─────────────────────────────────────────
BASE_PATH=/

# ─── OpenAI ─────────────────────────────────────────────────────────
# Used by the api-server directly
OPENAI_API_KEY=sk-...

# Used by the @workspace/integrations-openai-ai-server package
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Stripe (Payments) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Twilio (SMS) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567

# ─── Expo / Deployment ─────────────────────────────────────────────
# Required for Elysium (Expo) production builds; optional for local dev
EXPO_PUBLIC_DOMAIN=localhost:8081
REPLIT_DEV_DOMAIN=localhost:8081
REPL_ID=

# ─── Node ──────────────────────────────────────────────────────────
NODE_ENV=development
